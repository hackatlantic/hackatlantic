{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "esModuleInterop": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/app/App.tsx",
    "src/app/ApplyPage.tsx",
    "src/app/components/landing/**/*"
  ]
}
